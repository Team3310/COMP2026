# Limelight install files — downloaded from limelightvision.io
# These are large binary/installer files that should NOT be committed.
# Re-download from: https://docs.limelightvision.io/docs/resources/downloads

# Firmware / Hardware Manager installers
*.exe
*.dmg
*.img
*.img.xz

# Field maps (upload to each Limelight via web UI)
*.fmap

# Calibration board PDFs
*.pdf

# Neural network models
*.tflite
*.hef

# Neural network label files
*_labels.txt

# Pipeline files
*.vpr

# Calibration files
*.json

# Catch-all for any other large binaries
*.zip
*.tar.gz
*.bin
